rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUserFields(data) {
      return data.keys().hasOnly([
        'uid',
        'nickname',
        'nicknameNormalized',
        'stats',
        'settings',
        'lastGuessedDaily'
      ]);
    }

    function validUserWrite(uid) {
      return validUserFields(request.resource.data)
        && request.resource.data.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserWrite(uid);
      allow delete: if isOwner(uid);
      allow list: if false;
    }

    match /nicknames/{nicknameNormalized} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/nicknames/$(nicknameNormalized))
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'nicknameNormalized'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nicknameNormalized == nicknameNormalized;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /leaderboards/{leaderboardId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;

      match /entries/{uid} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false;
      }
    }

    match /userTokens/{uid} {
      allow get, create, update, delete: if isOwner(uid);
      allow list: if false;
    }
  }
}
